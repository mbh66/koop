filters:
  and:
    - file.ext == "md"
    - type == "member"
    - draft != true
    - '!file.inFolder("templates")'
    - '!file.inFolder("private")'
formulas:
  person: file.asLink(title)
properties:
  formula.person:
    displayName: Name
  town:
    displayName: Town
  phone:
    displayName: Phone
  email:
    displayName: Email
  skills:
    displayName: Skills
  passions:
    displayName: Passions
  offers:
    displayName: Offers
views:
  - type: table
    name: Everyone
    order:
      - formula.person
      - town
      - phone
      - skills
      - passions
      - offers
    sort:
      - property: title
        direction: ASC
  - type: table
    name: By town
    groupBy:
      property: town
      direction: ASC
    order:
      - formula.person
      - phone
      - skills
      - passions
    sort:
      - property: title
        direction: ASC
  # One view per skill. To add a skill: copy a block, change name and the value in contains(),
  # and add the skill to the list on members/index.md.
  - type: table
    name: Growing
    filters:
      and:
        - skills.contains("growing")
    order:
      - formula.person
      - town
      - phone
      - skills
    sort:
      - property: title
        direction: ASC
  - type: table
    name: Livestock
    filters:
      and:
        - skills.contains("livestock")
    order:
      - formula.person
      - town
      - phone
      - skills
    sort:
      - property: title
        direction: ASC
  - type: table
    name: Cooking
    filters:
      and:
        - skills.contains("cooking")
    order:
      - formula.person
      - town
      - phone
      - skills
    sort:
      - property: title
        direction: ASC
  - type: table
    name: Baking
    filters:
      and:
        - skills.contains("baking")
